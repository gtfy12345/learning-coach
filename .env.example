# The legacy MODEL_ID still works. CHAT_MODEL_ID controls diagnosis/teaching,
# while ASSESSMENT_MODEL_ID can use a different provider or model.
CHAT_MODEL_ID=openai:gpt-5-mini
# ASSESSMENT_MODEL_ID=anthropic:claude-sonnet-4-6

# Optional LCEL task fallbacks. If ASSESSMENT_FALLBACK_MODEL_ID is omitted,
# assessment inherits CHAT_FALLBACK_MODEL_ID. Empty values disable fallback.
# CHAT_FALLBACK_MODEL_ID=anthropic:claude-sonnet-4-6
# ASSESSMENT_FALLBACK_MODEL_ID=google_genai:gemini-2.5-flash-lite

# Official CLI login mode is selected by the model ID. It does not read the
# CLI token files and ignores provider API key variables in the child process.
# The local Web MVP uses these same model settings; it never exposes keys to
# the browser.
# CHAT_MODEL_ID=codex_cli:default
# CHAT_MODEL_ID=claude_code:sonnet
# CHAT_MODEL_ID=gemini_cli:default
# CLI_MODEL_TIMEOUT_SECONDS=300

# auto prefers provider-native JSON Schema, then tool calling. An authenticated
# Gemini CLI uses the explicit prompt_json fallback with Pydantic validation.
# Use native or tool to override incomplete profiles or compatible endpoints.
STRUCTURED_OUTPUT_STRATEGY=auto

# auto trusts the model profile. Use allow only when a compatible endpoint
# supports image input but does not publish profile metadata.
IMAGE_INPUT_POLICY=auto

# Provider credentials. Configure only the providers selected above.
OPENAI_API_KEY=replace-with-your-api-key
# ANTHROPIC_API_KEY=replace-with-your-api-key
# GOOGLE_API_KEY=replace-with-your-api-key

# For an OpenAI-compatible endpoint, keep the openai: prefix and set its URL.
# OPENAI_BASE_URL=https://example.com/v1

# Optional LangSmith tracing
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
