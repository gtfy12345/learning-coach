# LangChain uses the provider:model form. The bundled dependencies enable OpenAI.
MODEL_ID=openai:gpt-5-mini
OPENAI_API_KEY=replace-with-your-api-key

# For an OpenAI-compatible endpoint, uncomment this line and change MODEL_ID.
# OPENAI_BASE_URL=https://example.com/v1

# Optional LangSmith tracing
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
